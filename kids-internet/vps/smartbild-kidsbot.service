[Unit]
Description=SmartBild Kids Internet Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartbild-kidsbot
Group=smartbild-kidsbot
WorkingDirectory=/opt/smartbild-kidsbot
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/smartbild-kidsbot/app.py --config /etc/smartbild-kidsbot/config.json
Restart=always
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smartbild-kidsbot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
